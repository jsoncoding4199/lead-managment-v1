generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MASTER
  USER
}

enum LeadStatus {
  NEW
  CONTACT_ABLE
  CONTACT_NOT_ABLE
  DOCUMENTS_ABLE
  DOCUMENTS_NOT_ABLE
  APPOINTMENT_ABLE
  APPOINTMENT_NOT_ABLE
  SPAM_OR_MISSING
  REJECTED
  APPROVED
  RECYCLED
}

enum LeadQuality {
  GOOD
  MEDIUM
  LOW
}

// Where a lead lives. DEFAULT is the normal team pipeline shown in
// Fresh / Open Market / My Pick Up / Archive. AHA and AHB are private
// channels — master can create leads into them, and only the specific
// "owner" user assigned to that channel can see them (plus master).
enum LeadChannel {
  DEFAULT
  AHA
  AHB
}

model User {
  id           Int         @id @default(autoincrement())
  username     String      @unique
  passwordHash String
  displayName  String
  role         Role        @default(USER)
  active       Boolean     @default(true)
  // Legacy channel column from the AHA/AHB era. Kept for safety while the
  // new isPrivateChannel + Lead.privateChannelUserId model takes over.
  channel      LeadChannel @default(DEFAULT)
  // When true, this user owns their own private pipeline. Master can
  // assign leads to them, the user has a dedicated tab named after their
  // displayName, and only the user (plus master) sees those leads.
  isPrivateChannel Boolean  @default(false)
  createdAt    DateTime    @default(now())

  // Cumulative self-action counters. Incremented atomically by the
  // pickUp / drop actions; never decremented. Survive status changes,
  // reassignments, and lead deletions so the stats reflect each user's
  // total activity over time.
  pickUpsCount Int @default(0)
  dropsCount   Int @default(0)

  createdLeads        Lead[]                 @relation("CreatedBy")
  assignments         LeadAssignment[]       @relation("Assignee")
  assignmentsMade     LeadAssignment[]       @relation("AssignedBy")
  changes             LeadStatusChange[]
  resetRequests       PasswordResetRequest[] @relation("ResetSubject")
  resolvedResets      PasswordResetRequest[] @relation("ResetResolver")
  pushSubscriptions   PushSubscription[]
  notifications       Notification[]
  remarks             LeadRemark[]
  privateChannelLeads Lead[]                 @relation("PrivateChannelOwner")
  acknowledgedLeads   Lead[]                 @relation("LeadAckedBy")
  leadReminders       LeadReminder[]
}

// Per-user remark on a lead. Replaces the single Lead.remark string with a
// chat-style thread: any user with channel access can append a message, but
// only the author can edit their own. updatedAt > createdAt means the row
// has been edited (we never touch the row except via the edit action, so
// this comparison is reliable).
model LeadRemark {
  id        Int      @id @default(autoincrement())
  leadId    Int
  authorId  Int
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([leadId, createdAt])
}

// In-app notification feed. One row is created per recipient every time
// the server fires a push (sendPushToUsers). Recorded even when the user
// has no push subscription, so the in-app feed at /dashboard/notifications
// is the source of truth — push delivery is best-effort, this table is not.
model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  title     String
  body      String
  url       String?
  kind      String?
  createdAt DateTime  @default(now())
  readAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Browser-issued Web Push subscription. One row per (user, browser).
// A user who enables push on phone AND laptop gets two rows.
// endpoint is globally unique (issued by FCM / Mozilla / Apple push services).
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Lead {
  id           Int          @id @default(autoincrement())
  content      String
  // Optional structured contact fields — captured at intake so the card
  // can show tap-to-copy / tap-to-call / tap-to-WhatsApp rows without
  // regex-parsing the free-text content blob.
  name         String?
  ic           String?
  phone        String?
  remark       String?
  status       LeadStatus   @default(NEW)
  quality      LeadQuality?
  // Legacy channel column. Kept for safety; new code uses
  // privateChannelUserId instead.
  channel      LeadChannel  @default(DEFAULT)
  // When non-null, this lead belongs to the named user's private
  // pipeline — only that user (and master) may see/touch it.
  // null = public pipeline (Fresh/Market/Picks/Archive).
  privateChannelUserId Int?
  privateChannelUser   User? @relation("PrivateChannelOwner", fields: [privateChannelUserId], references: [id])
  // Sub-state used only while the main status is NEW. Tracks whether the
  // team has already tried to reach the lead. Values: "NEW", "CALLED_BEFORE",
  // "WHATSAPP_BEFORE". String column (not enum) to skip migration ceremony.
  contactState String       @default("NEW")
  // Latest "OK, seen it" acknowledgement. One slot is enough — master just
  // needs to see that somebody confirmed receipt (and who, most recently).
  ackedAt      DateTime?
  ackedById    Int?
  ackedBy      User?        @relation("LeadAckedBy", fields: [ackedById], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  createdById  Int
  // Lifetime counters for this lead. Incremented atomically inside the
  // pickUp / drop transactions; never decremented. Independent of which
  // user did the pickup or drop — they're a per-lead activity total.
  pickUpsCount Int          @default(0)
  dropsCount   Int          @default(0)

  createdBy   User               @relation("CreatedBy", fields: [createdById], references: [id])
  history     LeadStatusChange[]
  assignments LeadAssignment[]
  remarks     LeadRemark[]
  reminders   LeadReminder[]

  @@index([status])
  @@index([createdById])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([channel])
  @@index([privateChannelUserId])
}

model LeadAssignment {
  leadId       Int
  userId       Int
  assignedAt   DateTime @default(now())
  assignedById Int

  lead       Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user       User @relation("Assignee", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User @relation("AssignedBy", fields: [assignedById], references: [id])

  @@id([leadId, userId])
  @@index([userId])
}

// Singleton row (id = 1) that holds team-wide settings the master controls.
model AppSettings {
  id        Int @id @default(1)
  maxPickup Int @default(2)
}

// Per-user "remind me to follow up this lead in N hours" alarm. Cron sweeps
// LeadReminder rows every 5 minutes: rows with remindAt <= now trigger a
// push notification to the owning user, then get deleted.
model LeadReminder {
  id        Int      @id @default(autoincrement())
  leadId    Int
  userId    Int
  remindAt  DateTime
  createdAt DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([leadId, userId])
  @@index([remindAt])
}

model LeadStatusChange {
  id          Int         @id @default(autoincrement())
  leadId      Int
  fromStatus  LeadStatus?
  toStatus    LeadStatus
  note        String?
  changedById Int
  changedAt   DateTime    @default(now())

  lead      Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  changedBy User @relation(fields: [changedById], references: [id])

  @@index([leadId, changedAt])
}

model PasswordResetRequest {
  id           Int       @id @default(autoincrement())
  userId       Int
  user         User      @relation("ResetSubject", fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById Int?
  resolvedBy   User?     @relation("ResetResolver", fields: [resolvedById], references: [id])

  @@index([resolvedAt])
}
