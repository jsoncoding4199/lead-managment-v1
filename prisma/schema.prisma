generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MASTER
  USER
}

enum LeadStatus {
  NEW
  CONTACT_ABLE
  CONTACT_NOT_ABLE
  DOCUMENTS_ABLE
  DOCUMENTS_NOT_ABLE
  APPOINTMENT_ABLE
  APPOINTMENT_NOT_ABLE
  SPAM_OR_MISSING
  REJECTED
  APPROVED
}

enum LeadQuality {
  GOOD
  MEDIUM
  LOW
}

// Where a lead lives. DEFAULT is the normal team pipeline shown in
// Fresh / Open Market / My Pick Up / Archive. AHA and AHB are private
// channels — master can create leads into them, and only the specific
// "owner" user assigned to that channel can see them (plus master).
enum LeadChannel {
  DEFAULT
  AHA
  AHB
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  displayName  String
  role         Role     @default(USER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  // Cumulative self-action counters. Incremented atomically by the
  // pickUp / drop actions; never decremented. Survive status changes,
  // reassignments, and lead deletions so the stats reflect each user's
  // total activity over time.
  pickUpsCount Int @default(0)
  dropsCount   Int @default(0)

  createdLeads      Lead[]                 @relation("CreatedBy")
  assignments       LeadAssignment[]       @relation("Assignee")
  assignmentsMade   LeadAssignment[]       @relation("AssignedBy")
  changes           LeadStatusChange[]
  resetRequests     PasswordResetRequest[] @relation("ResetSubject")
  resolvedResets    PasswordResetRequest[] @relation("ResetResolver")
  pushSubscriptions PushSubscription[]
}

// Browser-issued Web Push subscription. One row per (user, browser).
// A user who enables push on phone AND laptop gets two rows.
// endpoint is globally unique (issued by FCM / Mozilla / Apple push services).
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Lead {
  id           Int          @id @default(autoincrement())
  content      String
  remark       String?
  status       LeadStatus   @default(NEW)
  quality      LeadQuality?
  channel      LeadChannel  @default(DEFAULT)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  createdById  Int

  createdBy   User               @relation("CreatedBy", fields: [createdById], references: [id])
  history     LeadStatusChange[]
  assignments LeadAssignment[]

  @@index([status])
  @@index([createdById])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([channel])
}

model LeadAssignment {
  leadId       Int
  userId       Int
  assignedAt   DateTime @default(now())
  assignedById Int

  lead       Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user       User @relation("Assignee", fields: [userId], references: [id], onDelete: Cascade)
  assignedBy User @relation("AssignedBy", fields: [assignedById], references: [id])

  @@id([leadId, userId])
  @@index([userId])
}

// Singleton row (id = 1) that holds team-wide settings the master controls.
model AppSettings {
  id        Int @id @default(1)
  maxPickup Int @default(2)
}

model LeadStatusChange {
  id          Int         @id @default(autoincrement())
  leadId      Int
  fromStatus  LeadStatus?
  toStatus    LeadStatus
  note        String?
  changedById Int
  changedAt   DateTime    @default(now())

  lead      Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  changedBy User @relation(fields: [changedById], references: [id])

  @@index([leadId, changedAt])
}

model PasswordResetRequest {
  id           Int       @id @default(autoincrement())
  userId       Int
  user         User      @relation("ResetSubject", fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById Int?
  resolvedBy   User?     @relation("ResetResolver", fields: [resolvedById], references: [id])

  @@index([resolvedAt])
}
