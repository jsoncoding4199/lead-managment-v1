# Postgres — Neon's pooled connection string works on Vercel out of the box.
# Get one free at https://neon.tech.
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# iron-session secret. Generate one with:  openssl rand -base64 32
SESSION_PASSWORD="change-me-to-a-32-character-or-longer-secret"

# Seed credentials for the initial master user (only used by `npm run seed`).
MASTER_USERNAME="master"
MASTER_PASSWORD="change-me"
MASTER_DISPLAY_NAME="Master"
